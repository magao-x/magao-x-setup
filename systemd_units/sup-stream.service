[Unit]
Description=MagAO-X web UI image streams (sup-stream)
Requires=network.target
After=network.target

[Service]
# ImageStreamIO opens shmims read-write, even to read them, so this user
# needs read and write access to the files in /milk/shm.
User=xsup
WorkingDirectory=/home/xsup
ExecStart=/opt/sup-trial/bin/sup-stream
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
